# LUMI Environment Variables Configuration Template
LUMI_ENV=development
LUMI_LOG_LEVEL=INFO
LUMI_DATA_DIR=data
LUMI_DB_PATH=data/lumi.db

# ============================================================
# Inworld.ai — Primary Conversation API (OpenAI-compatible)
# Sign up at https://platform.inworld.ai to get your API key
# ============================================================
INWORLD_API_KEY=

# ============================================================
# Fallback / Additional API Keys
# ============================================================
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# IP Webcam Configuration (Phone Camera + Mic)
# Install "IP Webcam" app on Android, start server, and enter your phone's IP
# ============================================================
LUMI_PHONE_STREAM_IP=192.168.1.100
